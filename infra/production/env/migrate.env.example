# /etc/markx/migrate.env: SECRET. Owner root, mode 600. Read ONLY by the
# one-time migration step, on top of api.env. The schema owner's password =
# MARKX_DB_MIGRATOR_PASSWORD in postgres.env.
MARKX_MIGRATION_DATABASE_URL=postgresql+psycopg://markx_migrator:REPLACE_WITH_MIGRATOR_PASSWORD@postgres:5432/markx
