# /etc/markx/backup.env: SECRET. Owner root, mode 600. Read by the backup
# service. The passphrase itself is the separate file /etc/markx/backup.key
# (at least 32 characters, owner 999, mode 400):
#   head -c 48 /dev/urandom | base64 > /etc/markx/backup.key
# Keep a copy of backup.key OFF the server, where the founder keeps it: a
# backup cannot be restored without it.
PGPASSWORD=REPLACE_WITH_MIGRATOR_PASSWORD
# Hour of the nightly dump, UTC (Addis Ababa is UTC+3; 23 = 02:00 there).
MARKX_BACKUP_HOUR_UTC=23
# Dumps older than this are removed from THIS server (blueprint: 30 days).
MARKX_BACKUP_KEEP_DAYS=30
