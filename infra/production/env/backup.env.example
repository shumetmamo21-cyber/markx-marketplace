# /etc/markx/backup.env: SECRET. Owner root, mode 600. Read by the backup
# service only (D-094; docs/runbooks/backup-and-restore.md). NOTHING HERE IS
# CONNECTED: the provider, the bucket, its location and the retention are the
# founder's decisions (F-16, F-14). Every REPLACE_WITH value must be replaced,
# and staging and production refuse to start the service until it is.
#
# The keys are separate files, made once with `python -m markx.backup keygen`
# on a trusted machine (docs/runbooks/backup-and-restore.md, "Keys"):
#   /etc/markx/backup-public.key   owner root, mode 644 (the recovery key's PUBLIC half)
#   /etc/markx/backup-signing.key  owner 999,  mode 400 (secret, signs manifests)
# The RECOVERY key never comes to this server: deploy.sh check refuses it.

# The database, as the schema owner (markx_migrator).
PGPASSWORD=REPLACE_WITH_MIGRATOR_PASSWORD

# Where the backup sets go: off-server, S3-compatible, a bucket of its own,
# private, created with S3 Object Lock in COMPLIANCE mode (staging and
# production refuse to start without it; PROVISIONAL, D-096, F-16), with an
# access key that can add, read and list THAT bucket only and NEVER DELETE
# (the exact rights: docs/runbooks/backup-and-restore.md, "Activating").
# Retention runs on another machine with another key; never put that key here.
#   s3: Amazon S3 (MARKX_BACKUP_DESTINATION_REGION required; endpoint optional)
#   r2: Cloudflare R2 (the account's https://<id>.r2.cloudflarestorage.com)
MARKX_BACKUP_DESTINATION=REPLACE_WITH_s3_OR_r2
MARKX_BACKUP_DESTINATION_ENDPOINT_URL=https://REPLACE_WITH_ENDPOINT
MARKX_BACKUP_DESTINATION_REGION=REPLACE_WITH_REGION
MARKX_BACKUP_DESTINATION_BUCKET=REPLACE_WITH_BACKUP_BUCKET
MARKX_BACKUP_DESTINATION_PREFIX=markx/production
MARKX_BACKUP_DESTINATION_ACCESS_KEY_ID=REPLACE_WITH_BACKUP_KEY_ID
MARKX_BACKUP_DESTINATION_SECRET_ACCESS_KEY=REPLACE_WITH_BACKUP_SECRET

# The stored files, READ ONLY: a key that can list and get the two file
# buckets and nothing else (never the API's own read-write key).
MARKX_BACKUP_SOURCE_PROVIDER=REPLACE_WITH_s3_OR_r2
MARKX_BACKUP_SOURCE_ENDPOINT_URL=https://REPLACE_WITH_ENDPOINT
MARKX_BACKUP_SOURCE_REGION=REPLACE_WITH_REGION
MARKX_BACKUP_SOURCE_PRIVATE_BUCKET=REPLACE_WITH_PRIVATE_BUCKET
MARKX_BACKUP_SOURCE_PUBLIC_BUCKET=REPLACE_WITH_PUBLIC_BUCKET
MARKX_BACKUP_SOURCE_ACCESS_KEY_ID=REPLACE_WITH_READ_ONLY_KEY_ID
MARKX_BACKUP_SOURCE_SECRET_ACCESS_KEY=REPLACE_WITH_READ_ONLY_SECRET

# Hour of the nightly set, UTC (Addis Ababa is UTC+3; 23 = 02:00 there).
MARKX_BACKUP_HOUR_UTC=23
# Retention: THE FOUNDER'S DECISION, required on staging and production.
# Days a complete set is kept (0 = keep every set), and how many of the
# newest complete sets are never deleted whatever their age. The blueprint
# says 30 days (H.2); that is not chosen here.
# (The server does not apply it: its key cannot delete. The retention job,
# run away from the server, uses the same two values; D-096.)
MARKX_BACKUP_RETENTION_DAYS=REPLACE_WITH_DAYS
MARKX_BACKUP_RETENTION_MIN_SETS=REPLACE_WITH_COUNT
# The bucket's object lock must be at least this many days (default 30,
# PROVISIONAL, F-16 and F-20). Uncomment only to set another value.
# MARKX_BACKUP_OBJECT_LOCK_MIN_DAYS=30
