# /etc/markx/postgres.env: SECRET. Owner root, mode 600. Read by PostgreSQL.
# The four passwords are used ONCE, when the database volume is empty (the
# first start); changing them later needs ALTER ROLE as well
# (docs/runbooks/secret-rotation.md). Use four different random values:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Never a value with "dev-only" in it: the API refuses those.
POSTGRES_PASSWORD=REPLACE_WITH_THE_SUPERUSER_PASSWORD
MARKX_DB_MIGRATOR_PASSWORD=REPLACE_WITH_MIGRATOR_PASSWORD
MARKX_DB_APP_PASSWORD=REPLACE_WITH_APP_PASSWORD
MARKX_DB_READONLY_PASSWORD=REPLACE_WITH_READONLY_PASSWORD
