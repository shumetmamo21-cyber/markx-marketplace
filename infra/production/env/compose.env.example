# /etc/markx/compose.env: NOT secret. What the Compose file itself needs
# (docs/DEPLOYMENT.md, "Settings"). Every value below is an EXAMPLE: the
# founder has not chosen a domain, a CDN hostname or a server (F-15, O.1).
# example.invalid can never resolve, so a forgotten example fails loudly.

# staging or production. deploy.sh refuses anything else.
MARKX_ENV=production
# Set by deploy.sh for each release (the Git commit); leave it out here.
# MARKX_RELEASE=
# Where the root-only settings files live.
MARKX_CONFIG_DIR=/etc/markx

# The site, as browsers see it: one hostname, HTTPS only.
MARKX_SITE_HOSTNAME=markx.example.invalid
MARKX_PUBLIC_ORIGIN=https://markx.example.invalid
# The picture CDN's own cookieless origin (F.6, F-15). Written into the web
# image at build time and checked again at start-up.
MARKX_MEDIA_ORIGIN=https://media.markx.example.invalid
# HTTPS-only memory in browsers, in seconds. The API sends one year too.
MARKX_HSTS_MAX_AGE=31536000

# The certificate (fullchain.pem, privkey.pem) and the challenge folder.
MARKX_TLS_DIR=/etc/markx/tls
MARKX_ACME_DIR=/var/lib/markx/acme
# FOUNDER (F-17, D-103): how the certificate is renewed. "none" (the default)
# until a domain exists: every certificate is installed by hand with
# `deploy.sh certificate install DIR` (also right for a Cloudflare origin
# certificate). "certbot": Let's Encrypt, HTTP challenge, renewed by the
# timer `deploy.sh certificate install-timer` installs; needs certbot on the
# host and MARKX_ACME_EMAIL. docs/runbooks/tls-certificates.md.
MARKX_TLS_RENEWAL=none
# MARKX_ACME_EMAIL=
# Days before expiry the worker's watch alerts, and `deploy.sh certificate
# check` fails (PROVISIONAL, P-103-1: 21; 8 to 90).
# MARKX_TLS_WARN_DAYS=21
# Where the nightly encrypted dumps are written on this server (owner 999).
MARKX_BACKUP_HOST_DIR=/var/backups/markx

# The images' name prefix: PREFIX/api, PREFIX/web, PREFIX/backup (D-103:
# deploy, rollback and the Compose file all use it).
# MARKX_IMAGE_PREFIX=markx

# Optional; the defaults suit a 2 GB server (blueprint M.3).
# MARKX_FRONTEND_SUBNET=172.30.10.0/24
# MARKX_API_WORKERS=2
# MARKX_PUBLIC_BIND=0.0.0.0
# MARKX_HTTP_PORT=80
# MARKX_HTTPS_PORT=443
# MARKX_POSTGRES_MEMORY=768m
# MARKX_API_MEMORY=640m
# MARKX_WORKER_MEMORY=512m
# MARKX_WEB_MEMORY=512m
# MARKX_PROXY_MEMORY=128m
# MARKX_BACKUP_MEMORY=384m
# MARKX_MIGRATE_MEMORY=640m
# CPU and process limits (D-103; PROVISIONAL, P-103-2): no CPU limit is above
# 1.0, so every service starts on a one-CPU server. Raise them with the
# server's real size; a limit above the server's CPU count stops the start.
# MARKX_POSTGRES_CPUS=1.0
# MARKX_API_CPUS=1.0
# MARKX_WORKER_CPUS=0.5
# MARKX_WEB_CPUS=0.5
# MARKX_PROXY_CPUS=0.5
# MARKX_BACKUP_CPUS=0.5
# MARKX_MIGRATE_CPUS=1.0
# MARKX_POSTGRES_PIDS=256
# MARKX_API_PIDS=256
# MARKX_WORKER_PIDS=128
# MARKX_WEB_PIDS=128
# MARKX_PROXY_PIDS=64
# MARKX_BACKUP_PIDS=128
# MARKX_MIGRATE_PIDS=64

# D-105 (BK-4): the container watch (deploy.sh watch, every 5 minutes) alerts
# the staff Telegram group when a container stays unhealthy, stopped or
# missing this many minutes (5 to 720; default 15, PROVISIONAL P-105-2).
# MARKX_CONTAINER_ALERT_MINUTES=15
