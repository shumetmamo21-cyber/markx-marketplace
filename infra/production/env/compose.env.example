# /etc/markx/compose.env: NOT secret. What the Compose file itself needs
# (docs/DEPLOYMENT.md, "Settings"). Every value below is an EXAMPLE: the
# founder has not chosen a domain, a CDN hostname or a server (F-15, O.1).
# example.invalid can never resolve, so a forgotten example fails loudly.

# staging or production. deploy.sh refuses anything else.
MARKX_ENV=production
# Set by deploy.sh for each release (the Git commit); leave it out here.
# MARKX_RELEASE=
# Where the root-only settings files live.
MARKX_CONFIG_DIR=/etc/markx

# The site, as browsers see it: one hostname, HTTPS only.
MARKX_SITE_HOSTNAME=markx.example.invalid
MARKX_PUBLIC_ORIGIN=https://markx.example.invalid
# The picture CDN's own cookieless origin (F.6, F-15). Written into the web
# image at build time and checked again at start-up.
MARKX_MEDIA_ORIGIN=https://media.markx.example.invalid
# HTTPS-only memory in browsers, in seconds. The API sends one year too.
MARKX_HSTS_MAX_AGE=31536000

# The certificate (fullchain.pem, privkey.pem) and the challenge folder.
MARKX_TLS_DIR=/etc/markx/tls
MARKX_ACME_DIR=/var/lib/markx/acme
# Where the nightly encrypted dumps are written on this server (owner 999).
MARKX_BACKUP_HOST_DIR=/var/backups/markx

# Optional; the defaults suit a 2 GB server (blueprint M.3).
# MARKX_FRONTEND_SUBNET=172.30.10.0/24
# MARKX_API_WORKERS=2
# MARKX_PUBLIC_BIND=0.0.0.0
# MARKX_HTTP_PORT=80
# MARKX_HTTPS_PORT=443
# MARKX_POSTGRES_MEMORY=768m
# MARKX_API_MEMORY=640m
# MARKX_WORKER_MEMORY=512m
# MARKX_WEB_MEMORY=512m
# MARKX_PROXY_MEMORY=128m
# MARKX_BACKUP_MEMORY=256m
