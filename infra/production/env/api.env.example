# /etc/markx/api.env: SECRET. Owner root, mode 600. Read by the API, the
# worker and the migration step. NEVER commit the real file, paste it into
# chat or a ticket, or put it in an image. Every value here is a placeholder.
# MARKX_ENV and MARKX_TRUSTED_PROXIES come from the Compose file itself.
# The API refuses to start, naming each problem, if anything below is
# missing or unsafe (apps/api/markx/core/config.py; docs/DEPLOYMENT.md).

# The application role only. Its password = MARKX_DB_APP_PASSWORD in postgres.env.
MARKX_DATABASE_URL=postgresql+psycopg://markx_app:REPLACE_WITH_APP_PASSWORD@postgres:5432/markx
# Deliberately WITHOUT a password: the API and worker never migrate. The
# migration step reads the full value from migrate.env.
MARKX_MIGRATION_DATABASE_URL=postgresql+psycopg://markx_migrator@postgres:5432/markx

# python -c "import secrets; print(secrets.token_urlsafe(48))"
MARKX_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing it makes staff authenticator secrets and payout account numbers
# unreadable: keep a copy where the founder keeps the backup passphrase.
MARKX_ENCRYPTION_KEY=REPLACE_WITH_A_FERNET_KEY

MARKX_PUBLIC_ORIGIN=https://markx.example.invalid
MARKX_COOKIE_SECURE=true
MARKX_LOG_LEVEL=INFO

# Bot check (D-085): the site's OWN Turnstile widget, not the localhost one.
MARKX_BOT_CHECK_PROVIDER=turnstile
MARKX_TURNSTILE_SECRET_KEY=REPLACE_WITH_THE_TURNSTILE_SECRET_KEY
MARKX_TURNSTILE_SITE_KEY=REPLACE_WITH_THE_TURNSTILE_SITE_KEY
MARKX_TURNSTILE_ALLOWED_HOSTNAMES=markx.example.invalid

# SMS (D-089). NO PROVIDER IS CHOSEN (F-11): until one is and its wire format
# is written, a real server cannot start, by design.
MARKX_SMS_PROVIDER=http
MARKX_SMS_API_URL=https://sms-provider.example.invalid/send
MARKX_SMS_API_KEY=REPLACE_WITH_THE_SMS_API_KEY
MARKX_SMS_SENDER_ID=MarkX

# Files (D-090). NO BUCKET EXISTS (F-01, F-14, F-15). s3 or r2 only.
MARKX_FILE_STORAGE_PROVIDER=r2
MARKX_STORAGE_ENDPOINT_URL=https://REPLACE_WITH_ACCOUNT_ID.r2.cloudflarestorage.com
# MARKX_STORAGE_REGION=eu-central-1        # s3 only
MARKX_STORAGE_ACCESS_KEY_ID=REPLACE_WITH_THE_STORAGE_KEY_ID
MARKX_STORAGE_SECRET_ACCESS_KEY=REPLACE_WITH_THE_STORAGE_SECRET
MARKX_STORAGE_PRIVATE_BUCKET=markx-private-REPLACE
MARKX_STORAGE_PUBLIC_BUCKET=markx-public-REPLACE
MARKX_PUBLIC_MEDIA_BASE_URL=https://media.markx.example.invalid

# Alerts (D-064). Without both, alerts reach only the log (a start-up warning).
# MARKX_TELEGRAM_BOT_TOKEN=
# MARKX_ALERT_TELEGRAM_CHAT_ID=

# Notifications to people's Telegram (D-092). NO BOT EXISTS YET (N-1): leave
# unset ("none"); every Telegram delivery is then recorded as unavailable and
# the in-app list still has every message. "bot_api" needs the bot token above.
# Notification SMS is a separate switch in the admin settings
# (notifications.sms_enabled), OFF by default.
# MARKX_TELEGRAM_PUSH_PROVIDER=bot_api

# Connecting people's Telegram accounts (D-093). OFF: leave it off until the
# founder authorises the bot (docs/runbooks/telegram-linking.md). Switched
# on, the API refuses to start without the bot's username and a real random
# webhook secret (32+ characters; never a test value).
# MARKX_TELEGRAM_LINKING_ENABLED=false
# MARKX_TELEGRAM_BOT_USERNAME=
# MARKX_TELEGRAM_WEBHOOK_SECRET=
# MARKX_TELEGRAM_LINK_TTL_MINUTES=10

# Only during an acknowledged code rollback (docs/runbooks/rollback.md).
# MARKX_ALLOW_NEWER_SCHEMA=true
