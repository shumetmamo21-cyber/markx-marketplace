# /etc/markx/web.env: owner root, mode 600. Read by the web app. The site key
# is public by design (every visitor's browser gets it), but it is the
# founder's own widget's: keep it with the other settings.
# Everything else the web app needs comes from compose.env.
MARKX_TURNSTILE_SITE_KEY=REPLACE_WITH_THE_TURNSTILE_SITE_KEY
