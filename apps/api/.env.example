# Copy to .env for local work. Never commit .env.
# Every value here is a placeholder or a laptop-only default. No real secret
# belongs in this file.

MARKX_ENV=local

# The API connects as the least-privileged role; migrations as the schema owner.
MARKX_DATABASE_URL=postgresql+psycopg://markx_app:markx_app_dev-only@127.0.0.1:5432/markx
MARKX_MIGRATION_DATABASE_URL=postgresql+psycopg://markx_migrator:markx_migrator_dev-only@127.0.0.1:5432/markx

# The one public origin the browser sees.
MARKX_PUBLIC_ORIGIN=http://localhost:3000
MARKX_COOKIE_SECURE=false

# Where uploaded files and the fake SMS inbox are kept on a laptop.
MARKX_STORAGE_DIR=./var/storage
# Where browsers load product pictures from; on a real server the CDN's own
# cookieless domain (blueprint F.6). On a laptop the API serves them itself.
# MARKX_PUBLIC_MEDIA_BASE_URL=/api/v1/media

# On staging and production these two MUST be set to real secrets, or the
# application refuses to start. Generate them; do not reuse these names.
#   MARKX_SECRET_KEY      at least 32 random characters
#   MARKX_ENCRYPTION_KEY  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# MARKX_SECRET_KEY=
# MARKX_ENCRYPTION_KEY=

# Telegram sign-in is off until a bot token is set.
# MARKX_TELEGRAM_BOT_TOKEN=
# Alerts (blueprint F.12) go to this private group's chat id once the bot
# token is set; otherwise they are written to the log at CRITICAL.
# MARKX_ALERT_TELEGRAM_CHAT_ID=

# The background worker (python -m markx.worker) rests this long between passes.
# MARKX_WORKER_POLL_SECONDS=5
