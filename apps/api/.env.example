# Copy to .env for local work. Never commit .env.
# Every value here is a placeholder or a laptop-only default. No real secret
# belongs in this file.

MARKX_ENV=local

# The API connects as the least-privileged role; migrations as the schema owner.
MARKX_DATABASE_URL=postgresql+psycopg://markx_app:markx_app_dev-only@127.0.0.1:5432/markx
MARKX_MIGRATION_DATABASE_URL=postgresql+psycopg://markx_migrator:markx_migrator_dev-only@127.0.0.1:5432/markx

# The one public origin the browser sees.
MARKX_PUBLIC_ORIGIN=http://localhost:3000
MARKX_COOKIE_SECURE=false

# Where uploaded files and the fake SMS inbox are kept on a laptop.
MARKX_STORAGE_DIR=./var/storage

# File storage (D-090). "local" keeps files in MARKX_STORAGE_DIR (laptop and
# tests). "minio" uses a MinIO server (laptop, Compose and tests only).
# Staging and production refuse both and need "s3" or "r2", with two
# DIFFERENT buckets: private (sellers' identity documents, picture sources,
# problem photos; never public) and public (rendered pictures, behind the
# CDN). WHICH PROVIDER HOLDS THE DOCUMENTS IS THE FOUNDER'S DECISION (F-01):
# no bucket or account has been created. The SECRET access key goes ONLY into
# the server's secret store, never into this file, Git or chat.
# MARKX_FILE_STORAGE_PROVIDER=minio
# MARKX_STORAGE_ENDPOINT_URL=http://127.0.0.1:9000   # r2: https://<account id>.r2.cloudflarestorage.com; s3: leave empty
# MARKX_STORAGE_REGION=                              # s3: the buckets' region (required); r2: auto
# MARKX_STORAGE_ACCESS_KEY_ID=markx-dev-only
# MARKX_STORAGE_SECRET_ACCESS_KEY=markx-minio-dev-only-password
# MARKX_STORAGE_PRIVATE_BUCKET=markx-private
# MARKX_STORAGE_PUBLIC_BUCKET=markx-public
# MARKX_STORAGE_SERVER_SIDE_ENCRYPTION=auto          # auto: AES256 on s3; r2 always encrypts
# MARKX_STORAGE_CONNECT_TIMEOUT_SECONDS=5
# MARKX_STORAGE_READ_TIMEOUT_SECONDS=15
# MARKX_STORAGE_MAX_OBJECT_BYTES=20000000
# Where browsers load product pictures from; on a real server the CDN's own
# cookieless domain (blueprint F.6), an https:// address on a different host
# from MARKX_PUBLIC_ORIGIN, or the API refuses to start. On a laptop the API
# serves them itself.
# MARKX_PUBLIC_MEDIA_BASE_URL=/api/v1/media

# On staging and production these two MUST be set to real secrets, or the
# application refuses to start. Generate them; do not reuse these names.
#   MARKX_SECRET_KEY      at least 32 random characters
#   MARKX_ENCRYPTION_KEY  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# MARKX_SECRET_KEY=
# MARKX_ENCRYPTION_KEY=

# The bot check before any sign-in code is sent (D-085). On a laptop the
# development check ("fake") answers and no key is needed. Staging and
# production refuse to start unless this is "turnstile" with both keys set.
# The SECRET key comes from Cloudflare's dashboard and goes ONLY into the
# server's secret store, never into this file, Git, the web app or chat.
# The site key is public; the web app needs the same value as
# MARKX_TURNSTILE_SITE_KEY in its own environment.
# MARKX_BOT_CHECK_PROVIDER=turnstile
# MARKX_TURNSTILE_SECRET_KEY=
# MARKX_TURNSTILE_SITE_KEY=
# Hostnames the widget may run on: bare names separated by commas, e.g.
# markx.et,www.markx.et (no https://, port, path or *). Empty means the host
# of MARKX_PUBLIC_ORIGIN. Staging and production refuse localhost.
# MARKX_TURNSTILE_ALLOWED_HOSTNAMES=
# MARKX_TURNSTILE_TIMEOUT_SECONDS=5

# SMS (D-089). On a laptop the fake sender ("fake") writes every message to
# the development inbox and nothing is sent. Staging and production refuse to
# start with "fake", and "http" refuses to start without the URL, key and
# sender below. NO PROVIDER HAS BEEN CHOSEN (blueprint O.23): "http" speaks
# MarkX's own placeholder format, not any provider's API, until a provider's
# wire format is written. The KEY goes ONLY into the server's secret store.
# MARKX_SMS_PROVIDER=http
# MARKX_SMS_API_URL=https://...   # the provider's fixed sending endpoint
# MARKX_SMS_API_KEY=
# MARKX_SMS_SENDER_ID=MarkX       # at most 11 letters/digits, or a number
# MARKX_SMS_TIMEOUT_SECONDS=8

# Telegram sign-in is off until a bot token is set.
# MARKX_TELEGRAM_BOT_TOKEN=
# Alerts (blueprint F.12) go to this private group's chat id once the bot
# token is set; otherwise they are written to the log at CRITICAL.
# MARKX_ALERT_TELEGRAM_CHAT_ID=
# Notifications to people's Telegram (D-092): "fake" (a laptop's default,
# written to storage/dev/push-outbox.jsonl), "none", or "bot_api" (needs the
# bot token). Staging and production refuse "fake" and default to "none".
# MARKX_TELEGRAM_PUSH_PROVIDER=fake
# Connecting a person's Telegram (D-093): OFF by default. Switched on, it
# needs the bot's username and the webhook secret (32+ characters of
# letters, digits, _ and -; for example: python -c "import secrets;
# print(secrets.token_urlsafe(48))"). docs/runbooks/telegram-linking.md.
# MARKX_TELEGRAM_LINKING_ENABLED=false
# MARKX_TELEGRAM_BOT_USERNAME=
# MARKX_TELEGRAM_WEBHOOK_SECRET=
# MARKX_TELEGRAM_LINK_TTL_MINUTES=10

# The background worker (python -m markx.worker) rests this long between passes.
# MARKX_WORKER_POLL_SECONDS=5
