{
  "name": "markx-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "gen:api": "openapi-typescript src/lib/api/openapi.json --output src/lib/api/schema.d.ts"
  },
  "dependencies": {
    "next": "16.4.6",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "openapi-typescript": "7.13.0",
    "playwright": "1.63.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
