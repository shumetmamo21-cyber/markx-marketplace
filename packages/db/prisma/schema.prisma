// MarkX marketplace data model.
// Money is stored as an integer number of minor units (see @markx/shared).

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

// Connection URL is configured in prisma.config.ts (Prisma 7+).
datasource db {
  provider = "postgresql"
}

enum UserRole {
  BUYER
  SELLER
  ADMIN
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  CANCELLED
  REFUNDED
}

model User {
  id           String    @id @default(cuid(2))
  email        String    @unique
  name         String?
  role         UserRole  @default(BUYER)
  passwordHash String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sellerProfile SellerProfile?
  addresses     Address[]
  orders        Order[]
  reviews       Review[]
  cart          Cart?

  @@index([role])
}

model SellerProfile {
  id        String   @id @default(cuid(2))
  userId    String   @unique
  storeName String
  storeSlug String   @unique
  bio       String?
  /// Platform commission in basis points. 250 == 2.50%.
  commissionBps Int   @default(500)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  products   Product[]
  orderItems OrderItem[]
}

model Category {
  id       String  @id @default(cuid(2))
  name     String
  slug     String  @unique
  parentId String?

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
}

model Product {
  id          String        @id @default(cuid(2))
  sellerId    String
  categoryId  String?
  title       String
  slug        String        @unique
  description String        @default("")
  /// Integer minor units of `currency`.
  priceMinor  Int
  currency    String        @default("ETB")
  status      ProductStatus @default(DRAFT)
  inventory   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  seller     SellerProfile  @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category   Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images     ProductImage[]
  orderItems OrderItem[]
  reviews    Review[]
  cartItems  CartItem[]

  @@index([sellerId])
  @@index([categoryId])
  @@index([status])
}

model ProductImage {
  id        String @id @default(cuid(2))
  productId String
  url       String
  alt       String @default("")
  position  Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
}

model Address {
  id          String  @id @default(cuid(2))
  userId      String
  fullName    String
  line1       String
  line2       String?
  city        String
  region      String?
  postalCode  String?
  /// ISO 3166-1 alpha-2.
  countryCode String
  phone       String?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
}

model Order {
  id       String      @id @default(cuid(2))
  buyerId  String
  status   OrderStatus @default(PENDING)
  currency String      @default("ETB")

  subtotalMinor Int
  shippingMinor Int @default(0)
  taxMinor      Int @default(0)
  totalMinor    Int

  shippingAddressId String?
  placedAt          DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  buyer           User        @relation(fields: [buyerId], references: [id])
  shippingAddress Address?    @relation(fields: [shippingAddressId], references: [id], onDelete: SetNull)
  items           OrderItem[]

  @@index([buyerId])
  @@index([status])
}

model OrderItem {
  id        String @id @default(cuid(2))
  orderId   String
  productId String?
  sellerId  String

  /// Snapshot of product details at purchase time — products mutate, orders must not.
  titleSnapshot   String
  unitPriceMinor  Int
  quantity        Int
  totalMinor      Int
  commissionMinor Int @default(0)

  order   Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  seller  SellerProfile @relation(fields: [sellerId], references: [id])

  @@index([orderId])
  @@index([sellerId])
  @@index([productId])
}

model Review {
  id        String   @id @default(cuid(2))
  productId String
  authorId  String
  /// 1–5, enforced in application validation.
  rating    Int
  body      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([productId, authorId])
  @@index([productId])
}

model Cart {
  id        String   @id @default(cuid(2))
  userId    String   @unique
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id        String @id @default(cuid(2))
  cartId    String
  productId String
  quantity  Int    @default(1)

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@index([cartId])
}
